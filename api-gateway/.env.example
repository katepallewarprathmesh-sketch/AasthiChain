# AasthiChain API Gateway — Env Config for Track A1 Live/Mock Toggle

PORT=8080

# Track A1: Fabric Mode — live tries real Fabric Gateway SDK, mock uses seed data with same interface
# Set to live when crypto-config exists and peer reachable
FABRIC_MODE=mock
# FABRIC_MODE=live

# Live mode config — only needed when FABRIC_MODE=live
FABRIC_MSP_ID=OriginatorMSP
FABRIC_CERT_PATH=../network/crypto-config/peerOrganizations/originator.aasthichain.com/users/Admin@originator.aasthichain.com/msp/signcerts/cert.pem
FABRIC_KEY_PATH=../network/crypto-config/peerOrganizations/originator.aasthichain.com/users/Admin@originator.aasthichain.com/msp/keystore/
FABRIC_TLS_CERT_PATH=../network/crypto-config/peerOrganizations/originator.aasthichain.com/peers/peer0.originator.aasthichain.com/tls/ca.crt
FABRIC_PEER_ENDPOINT=localhost:7051
FABRIC_GATEWAY_PEER=peer0.originator.aasthichain
FABRIC_CHANNEL=property-channel
FABRIC_CHAINCODE=aasthichain

# Track A4: Idempotency persistence
IDEMPOTENCY_DATA_DIR=./data
# Optional Redis for prod — if set, use Redis instead of file
# REDIS_URL=redis://localhost:6379
# REDIS_IDEMPOTENCY_TTL=24h

# JWT
JWT_SECRET=aasthichain-hackathon-secret-key-change-in-prod

# Rate limiting
RATE_LIMIT_PER_MINUTE=100
