# Clerk Auth — linked to app_3JYZzmHh7xcd6GbP8WmcAySBPFv
# Get from https://dashboard.clerk.com -> App: AasthiChain -> API Keys -> Publishable Key
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your-key-here

# Demo bypass for hackathon judges — bypass email-code verification for instant access
# Set to true to show "Continue as Demo Investor/Registrar/Regulator" buttons (default true)
# Set to false to force full Clerk verification for all users
VITE_ENABLE_DEMO_BYPASS=true

# To auto-pull keys via CLI (run locally, not in sandbox):
# clerk auth login
# clerk env pull --app app_3JYZzmHh7xcd6GbP8WmcAySBPFv
# or: clerk init --app app_3JYZzmHh7xcd6GbP8WmcAySBPFv (in frontend dir)

# Optional: backend Clerk verification (for Go gateway)
# CLERK_SECRET_KEY=sk_test_...
# CLERK_JWKS_URL=https://your-clerk-domain/.well-known/jwks.json
# CLERK_ISSUER=https://your-clerk-domain
