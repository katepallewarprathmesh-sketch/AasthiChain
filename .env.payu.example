# PayU TEST credentials — paste yours from PayU Dashboard → Test Mode → Key Salt Details
# (this file is a template; the real .env.payu is gitignored — never commit credentials)
NPCI_MODE=payu
PAYU_MERCHANT_KEY=<your test key>
PAYU_SALT=<your test salt>
PAYU_BASE_URL=https://test.payu.in
# PUBLIC_BASE_URL=https://aasthi-chain.vercel.app   # so PayU's redirect reaches /api/npci/payu/callback
