####################################################################
# AasthiChain environment template
#
# Copy to .env and fill in only what you need. NOTHING HERE IS A REAL
# CREDENTIAL, and nothing in this file is required to run the demo:
# the defaults below are enough for a full local stack.
#
#   cp .env.example .env
#
# .env is gitignored. This file is not. Keep it that way.
####################################################################

# ---------------------------------------------------------------
# Core (the only two most people need)
# ---------------------------------------------------------------

# Where the Go settlement rail is listening. REQUIRED by the app: without
# it every rail route answers 503 ERR_UMI_RAIL_UNAVAILABLE even when the
# rail is running.
UMI_GATEWAY_URL=http://localhost:21100

# Port for the Node app that serves the built frontend and the API.
PORT=8080

# ---------------------------------------------------------------
# Demo authentication
# ---------------------------------------------------------------

# Accept the demo identities (originator1, registrar1, investor1,
# investor2, regulator1) without a real sign-in. LOCAL AND DEMO ONLY.
# Leave this unset in any deployment you would not hand to a stranger.
DEMO_AUTH=true

# Let a signed-in demo user switch role in place. Set to false to close
# the hole that self-selectable roles open.
DEMO_ROLE_SWITCH=true

# Operator-only endpoints. Server side only: this value must never be
# sent to a browser. Generate your own with `openssl rand -hex 32`.
ADMIN_DASHBOARD_KEY=

# ---------------------------------------------------------------
# Settlement rail (drunix-gateway)
# ---------------------------------------------------------------

UMI_ENABLED=true
UMI_SEED_DEMO=true
DRUNIX_MODE=mock

# Shared secret between the app and the rail. When set on BOTH, the rail
# stops trusting identity headers from anywhere else.
UMI_PROXY_SECRET=

# Where the rail keeps its ledger. Unset means a file under the working
# directory, which is fine for local use.
UMI_DATABASE_URL=

# ---------------------------------------------------------------
# Limits and transport
# ---------------------------------------------------------------

# Largest accepted request body, in bytes. Over this the app answers 413.
MAX_BODY_BYTES=1048576

# Comma-separated allowlist of browser origins. The default is "*",
# because the read surface is public. Set it to lock the API down.
# CORS_ALLOW_ORIGIN=https://example.com,https://www.example.com

# ---------------------------------------------------------------
# Persistence (optional: the demo runs on files without any of this)
# ---------------------------------------------------------------

DATABASE_URL=
POSTGRES_URL=
KV_REST_API_URL=
KV_URL=

# ---------------------------------------------------------------
# Payments. TEST ENVIRONMENT ONLY.
# ---------------------------------------------------------------
# Leave NPCI_MODE unset to keep the money leg simulated. The "payu" mode
# talks to the provider's TEST host and nothing else. Never put a live
# merchant key or salt in this repository or in a .env file you share.
# See .env.payu.example for the full payment configuration.

NPCI_MODE=
PAYU_MERCHANT_KEY=
PAYU_SALT=
PAYU_BASE_URL=https://test.payu.in/_payment

# ---------------------------------------------------------------
# Optional integrations, all off by default
# ---------------------------------------------------------------

# Public-chain document mirror. Without these the mirror stays simulated.
EVM_RPC_URL=
EVM_REGISTRY_ADDRESS=
EVM_SENDER_ADDRESS=

# IPFS. Without an API URL, document storage stays simulated.
IPFS_API_URL=
IPFS_GATEWAY_URL=

# AI assistant. Without a key the assistant is disabled, not faked.
GROQ_API_KEY=

# Work desk talent provider. The adapter is a simulation; these only
# matter if you point it at something of your own.
WORK_ENABLED=
WORK_PROVIDER_URL=
WORK_PROVIDER_KEY=
